# Resend
RESEND_API_KEY=
RESEND_FROM="Miguel Cedillo <outreach@voxmedia.com.mx>"
RESEND_REPLY_TO=miguel@voxmedia.com.mx

# Telegram
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_CHAT_ID=

# ElevenLabs / Twilio
ELEVENLABS_API_KEY=
ELEVENLABS_AGENT_ID=agent_01jypeb3njep7addtqsfjccekz
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# Fish Audio (opcional, solo para el command center /jarvis).
# Mas facil: pega la llave en llaves/fish-audio.txt (ver llaves/LEEME.md).
# Si esta en los dos lugares, gana llaves/fish-audio.txt.
# Sin llave el prototipo usa la voz del navegador. Con llave cambia solo a Fish.
# Llave: crea cuenta en fish.audio y genera una API key en tu panel.
# Voz: el ID de una voz en espanol de la biblioteca de Fish (aparece en su URL).
FISH_AUDIO_API_KEY=
FISH_AUDIO_VOICE_ID=
FISH_AUDIO_MODEL=s2.1-pro-free

# Command center /jarvis: cerebro de Vera. Mas facil en llaves/ (ver LEEME).
# Con FREELLMAPI_API_KEY usa FreeLLMAPI; si no, las OPENROUTER_* de arriba.
FREELLMAPI_API_KEY=
FREELLMAPI_BASE_URL=http://127.0.0.1:31415/v1
FREELLMAPI_MODEL=auto:fast
# Solo para pruebas o proxies compatibles:
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# FISH_AUDIO_BASE_URL=https://api.fish.audio
